<%- include('partials/header') %>
    <div class="form-container">
        <div class="card">
            <h2>发表新帖子</h2>
            <form action="/posts" method="POST">
                <input type="hidden" name="content_type" value="markdown">
                <div class="form-group">
                    <label for="title" class="form-label">标题</label>
                    <input type="text" id="title" name="title" class="form-control" placeholder="输入帖子标题" required>
                </div>
                <div class="form-group">
                    <label for="content" class="form-label">内容 (支持Markdown语法)</label>
                    <textarea id="content" name="content" class="form-control" 
                              placeholder="输入帖子内容 (支持**粗体**、*斜体*、[链接](http://example.com)等Markdown语法)" 
                              required rows="10"></textarea>
                    <div class="markdown-tips" style="font-size: 0.8rem; color: var(--secondary-color); margin-top: 0.5rem;">
                        Markdown提示: **粗体**、*斜体*、`代码`、[链接](url)、> 引用、- 列表
                    </div>
                </div>
                <div class="form-group">
                    <label for="category" class="form-label">分类</label>
                    <select id="category" name="category" class="form-control">
                        <option value="general">综合讨论</option>
                        <option value="questions">问题求助</option>
                        <option value="announcements">公告通知</option>
                        <option value="resources">学习资源</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">发布</button>
                <a href="/" class="btn" style="margin-left: 1rem;">取消</a>
            </form>
        </div>
    </div>
<%- include('partials/footer') %>
