<%- include('partials/header') %>
    <section class="page-title">
        <span class="eyebrow" data-i18n="settings.eyebrow">Account</span>
        <h1 data-i18n="settings.title">用户设置</h1>
    </section>

    <section class="layout-grid settings-layout">
        <div class="settings-main">
            <article class="card section-card">
                <h3 data-i18n="settings.accountInfo">账户信息</h3>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label" data-i18n="settings.email">邮箱</span>
                        <span class="info-value"><%= user.email %></span>
                    </div>
                    <div class="info-item">
                        <span class="info-label" data-i18n="settings.name">昵称</span>
                        <span class="info-value"><%= user.name %></span>
                    </div>
                    <div class="info-item">
                        <span class="info-label" data-i18n="settings.grade">年级</span>
                        <span class="info-value" id="current-grade"><%= user.grade %></span>
                        <button type="button" class="btn btn-sm btn-ghost" onclick="showGradeEdit()">修改年级</button>
                    </div>
                    <% if (['G6', 'G7', 'G8'].includes(user.grade)) { %>
                    <div class="info-item" id="class-info-item">
                        <span class="info-label">班级</span>
                        <span class="info-value" id="current-class"><%= user.class_name || '-' %></span>
                        <button type="button" class="btn btn-sm btn-ghost" onclick="showClassEdit()">修改班级</button>
                    </div>
                    <% } %>
                    <div class="info-item">
                        <span class="info-label" data-i18n="settings.registeredAt">注册时间</span>
                        <span class="info-value"><%= formatDate(user.created_at, true) %></span>
                    </div>
                </div>
            </article>

            <article class="card section-card">
                <h3 data-i18n="settings.levelInfo">等级信息</h3>
                <div class="level-display">
                    <div class="level-badge" style="background: <%= roleInfo ? roleInfo.badge_color : '#666' %>">
                        <%= roleInfo ? roleInfo.name : 'LV' + user.role_level %>
                    </div>
                    <div class="level-name">
                        <%= roleInfo ? roleInfo.name : 'Unknown' %>
                    </div>
                </div>
                <div class="credit-display">
                    <div class="credit-item">
                        <span class="credit-value"><%= credit ? credit.credit : 0 %></span>
                        <span class="credit-label" data-i18n="settings.credit">信用分</span>
                    </div>
                </div>
                <% if (nextLevel && nextLevel.min_credit > 0) { %>
                    <% const currentCredit = credit ? credit.credit : 0; %>
                    <% const progress = Math.min(100, Math.round((currentCredit / nextLevel.min_credit) * 100)); %>
                    <% const needed = nextLevel.min_credit - currentCredit; %>
                    <div class="upgrade-progress">
                        <div class="progress-header">
                            <span data-i18n="settings.nextLevel">距升级至</span>
                            <strong><%= nextLevel.name %></strong>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: <%= progress %>%;"></div>
                        </div>
                        <div class="progress-footer">
                            <span><%= currentCredit %> / <%= nextLevel.min_credit %></span>
                            <span data-i18n="settings.creditsNeeded"><%= needed %> 信用分</span>
                        </div>
                    </div>
                <% } else if (user.role_level >= 5) { %>
                    <div class="max-level-notice">
                        <span data-i18n="settings.maxLevel">已达到最高等级</span>
                    </div>
                <% } %>
            </article>

            <article class="card section-card">
                <h3>每日额度</h3>
                <div class="quota-grid">
                    <div class="quota-item">
                        <span class="quota-label">举报次数</span>
                        <span class="quota-value">
                            <% if (reportLimit > 0) { %>
                                <%= reportRemaining %>/<%= reportLimit %> 次
                            <% } else { %>
                                不可举报
                            <% } %>
                        </span>
                    </div>
                    <div class="quota-item">
                        <span class="quota-label">申诉次数</span>
                        <span class="quota-value">
                            <% if (appealLimit === -1) { %>
                                无限制
                            <% } else if (appealLimit > 0) { %>
                                <%= appealRemaining %>/<%= appealLimit %> 次
                            <% } else { %>
                                不可申诉
                            <% } %>
                        </span>
                    </div>
                </div>
            </article>

            <article class="card section-card">
                <h3 data-i18n="settings.currentPermissions">当前权限</h3>
                <ul class="permissions-list">
                    <li><span class="permission-check">✓</span><span>聊天发言<% if (user.role_level <= 1) { %>（需AI审核）<% } %></span></li>
                    <% if (user.role_level >= 1) { %>
                        <li><span class="permission-check">✓</span><span>发布CJ作业<% if (user.role_level <= 2) { %>（需AI+人工审核）<% } %></span></li>
                    <% } else { %>
                        <li><span class="permission-lock">🔒</span><span>发布CJ作业（需LV1）</span></li>
                    <% } %>
                    <% if (user.role_level >= 2) { %>
                        <li><span class="permission-check">✓</span><span>发布文章/笔记<% if (user.role_level <= 3) { %>（需AI+人工审核）<% } else if (user.role_level === 4) { %>（需AI审核）<% } %></span></li>
                    <% } else { %>
                        <li><span class="permission-lock">🔒</span><span>发布文章/笔记（需LV2）</span></li>
                    <% } %>
                    <% if (user.role_level >= 4) { %>
                        <li><span class="permission-check">✓</span><span>上传资源<% if (user.role_level === 4) { %>（需人工审核）<% } %></span></li>
                    <% } else { %>
                        <li><span class="permission-lock">🔒</span><span>上传资源（需LV4）</span></li>
                    <% } %>
                    <% if (user.role_level >= 3) { %>
                        <li><span class="permission-check">✓</span><span>参与内容审核</span></li>
                    <% } else { %>
                        <li><span class="permission-lock">🔒</span><span>参与内容审核（需LV3）</span></li>
                    <% } %>
                    <% if (user.role_level >= 1) { %>
                        <li><span class="permission-check">✓</span><span>举报内容（每日<%= reportLimit %>次）</span></li>
                    <% } else { %>
                        <li><span class="permission-lock">🔒</span><span>举报内容（需LV1）</span></li>
                    <% } %>
                    <% if (user.role_level >= 3) { %>
                        <li><span class="permission-check">✓</span><span>申诉审核结果<% if (appealLimit > 0) { %>（每日<%= appealLimit %>次）<% } %></span></li>
                    <% } else { %>
                        <li><span class="permission-lock">🔒</span><span>申诉审核结果（需LV3）</span></li>
                    <% } %>
                </ul>
            </article>

            <article class="card section-card">
                <h3 data-i18n="settings.levelProgression">等级权限说明</h3>
                <div class="level-grid">
                    <% allRoles.forEach(role => { %>
                        <div class="level-item <%= role.level === user.role_level ? 'current' : '' %>">
                            <div class="level-header">
                                <span class="level-badge-small" style="background: <%= role.badge_color %>"><%= role.name %></span>
                                <span class="level-requirement"><%= role.min_credit %> <span data-i18n="settings.credits">信用分</span></span>
                            </div>
                            <ul class="level-permissions">
                                <% if (role.level === 0) { %>
                                    <li>聊天（AI审核），不可发布其他内容</li>
                                <% } else if (role.level === 1) { %>
                                    <li>聊天（AI审核），CJ（AI+人工），举报5次/日</li>
                                <% } else if (role.level === 2) { %>
                                    <li>聊天（免审），文章/CJ（AI+人工），举报5次/日</li>
                                <% } else if (role.level === 3) { %>
                                    <li>文章（AI+人工），可审核，举报10次，申诉3次</li>
                                <% } else if (role.level === 4) { %>
                                    <li>资源（人工），文章（AI），申诉5次</li>
                                <% } else if (role.level === 5) { %>
                                    <li>资源免审，申诉无限制，高级审核权</li>
                                <% } %>
                            </ul>
                        </div>
                    <% }) %>
                </div>
            </article>

            <article class="card section-card">
                <h3 data-i18n="settings.creditHistory">信用分历史</h3>
                <% if (creditHistory && creditHistory.length) { %>
                    <div class="history-list">
                        <% creditHistory.forEach(log => { %>
                            <div class="history-item">
                                <div class="history-main">
                                    <span class="history-delta <%= log.delta > 0 ? 'positive' : 'negative' %>">
                                        <%= log.delta > 0 ? '+' : '' %><%= log.delta %>
                                    </span>
                                    <span class="history-reason"><%= log.reason %></span>
                                </div>
                                <div class="history-meta">
                                    <span class="history-date"><%= formatDate(log.created_at, true) %></span>
                                    <% if (log.reviewer_name) { %>
                                        <span class="history-reviewer">by <%= log.reviewer_name %></span>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-state" data-i18n="settings.noHistory">暂无信用分记录</div>
                <% } %>
            </article>

            <article class="card section-card danger-zone">
                <h3 data-i18n="settings.dangerZone">危险区域</h3>
                <p class="helper-text" data-i18n="settings.deactivateWarning">注销账户后，所有数据将被永久删除且无法恢复。</p>
                <button class="btn btn-danger" type="button" onclick="showDeactivateModal()" data-i18n="settings.deactivateAccount">注销账户</button>
            </article>
        </div>

        <aside class="settings-sidebar">
            <article class="card section-card">
                <h3 data-i18n="settings.usageGuide">BGHub使用说明</h3>
                <div class="markdown-body usage-guide-content">
                    <%- renderMarkdown(usageGuideContent || '') %>
                </div>
            </article>
        </aside>
    </section>

    <div class="modal modal-hidden" id="deactivate-modal">
        <div class="modal-backdrop" onclick="hideDeactivateModal()"></div>
        <div class="modal-content">
            <h3 data-i18n="settings.confirmDeactivate">确认注销账户</h3>
            <p data-i18n="settings.deactivatePrompt">请输入密码以确认注销账户。</p>
            <form id="deactivate-form">
                <input class="form-control" type="password" name="password" data-i18n-placeholder="settings.passwordPlaceholder" placeholder="" required>
                <div class="modal-actions">
                    <button class="btn btn-ghost" type="button" onclick="hideDeactivateModal()" data-i18n="common.cancel">取消</button>
                    <button class="btn btn-danger" type="submit" data-i18n="settings.confirmDeactivateBtn">确认注销</button>
                </div>
            </form>
            <div class="modal-error modal-hidden" id="deactivate-error"></div>
        </div>
    </div>

    <div class="modal modal-hidden" id="grade-edit-modal">
        <div class="modal-backdrop" onclick="hideGradeEditModal()"></div>
        <div class="modal-content">
            <h3>修改年级</h3>
            <form id="grade-edit-form">
                <label class="form-group">
                    <span class="form-label">新年级</span>
                    <select name="grade" class="form-control" id="grade-new-select" required>
                        <option value="">选择年级</option>
                        <% ['G6','G7','G8','G9','G10','G11','G12'].forEach(g => { %>
                            <option value="<%= g %>"><%= g %></option>
                        <% }) %>
                    </select>
                </label>
                <label class="form-group">
                    <span class="form-label">密码验证</span>
                    <input class="form-control" type="password" name="password" placeholder="输入密码确认" required>
                </label>
                <div class="modal-actions">
                    <button class="btn btn-ghost" type="button" onclick="hideGradeEditModal()">取消</button>
                    <button class="btn btn-primary" type="submit">保存</button>
                </div>
            </form>
            <div class="modal-error modal-hidden" id="grade-edit-error"></div>
        </div>
    </div>

    <div class="modal modal-hidden" id="class-edit-modal">
        <div class="modal-backdrop" onclick="hideClassEditModal()"></div>
        <div class="modal-content">
            <h3>修改班级</h3>
            <form id="class-edit-form">
                <label class="form-group">
                    <span class="form-label">新班级</span>
                    <select name="class_name" class="form-control" id="class-new-select" required>
                        <option value="">选择班级</option>
                    </select>
                    <span class="helper-text" id="class-edit-loading" style="color: var(--muted); display: none;">加载班级中...</span>
                </label>
                <label class="form-group">
                    <span class="form-label">密码验证</span>
                    <input class="form-control" type="password" name="password" placeholder="输入密码确认" required>
                </label>
                <div class="modal-actions">
                    <button class="btn btn-ghost" type="button" onclick="hideClassEditModal()">取消</button>
                    <button class="btn btn-primary" type="submit">保存</button>
                </div>
            </form>
            <div class="modal-error modal-hidden" id="class-edit-error"></div>
        </div>
    </div>

    <script>
    function showDeactivateModal() {
        document.getElementById('deactivate-modal').classList.remove('modal-hidden');
    }

    function hideDeactivateModal() {
        document.getElementById('deactivate-modal').classList.add('modal-hidden');
        document.getElementById('deactivate-error').classList.add('modal-hidden');
        document.getElementById('deactivate-form').reset();
    }

    function showGradeEdit() {
        document.getElementById('grade-edit-modal').classList.remove('modal-hidden');
    }

    function hideGradeEditModal() {
        document.getElementById('grade-edit-modal').classList.add('modal-hidden');
        document.getElementById('grade-edit-error').classList.add('modal-hidden');
        document.getElementById('grade-edit-form').reset();
    }

    function showClassEdit() {
        document.getElementById('class-edit-modal').classList.remove('modal-hidden');
        loadClassesForGradeEdit();
    }

    function hideClassEditModal() {
        document.getElementById('class-edit-modal').classList.add('modal-hidden');
        document.getElementById('class-edit-error').classList.add('modal-hidden');
        document.getElementById('class-edit-form').reset();
    }

    async function loadClassesForGradeEdit() {
        var gradeSelect = document.getElementById('grade-new-select');
        var classSelect = document.getElementById('class-new-select');
        var loadingMsg = document.getElementById('class-edit-loading');
        var currentGrade = document.getElementById('current-grade').textContent;

        if (!['G6', 'G7', 'G8'].includes(currentGrade)) {
            gradeSelect = document.getElementById('grade-new-select');
        }

        var grade = currentGrade;
        if (gradeSelect && ['G6', 'G7', 'G8'].includes(gradeSelect.value)) {
            grade = gradeSelect.value;
        }

        classSelect.innerHTML = '<option value="">加载中...</option>';
        loadingMsg.style.display = 'block';

        try {
            var res = await fetch('/api/grades/classes?grade=' + encodeURIComponent(grade));
            var data = await res.json();

            if (!res.ok) {
                throw new Error(data.error || '加载失败');
            }

            var classes = data.classes || [];
            if (classes.length === 0) {
                classSelect.innerHTML = '<option value="">该年级暂无班级配置</option>';
            } else {
                classSelect.innerHTML = '<option value="">选择班级</option>';
                classes.forEach(function(cls) {
                    var option = document.createElement('option');
                    option.value = cls.class_name;
                    option.textContent = 'Class ' + cls.class_name;
                    classSelect.appendChild(option);
                });
            }
        } catch (err) {
            classSelect.innerHTML = '<option value="">加载失败</option>';
        } finally {
            loadingMsg.style.display = 'none';
        }
    }

    document.getElementById('deactivate-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const errorEl = document.getElementById('deactivate-error');

        try {
            const response = await fetch('/api/settings/deactivate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ password: formData.get('password') })
            });

            const data = await response.json();

            if (!response.ok) {
                errorEl.textContent = data.error || '操作失败';
                errorEl.classList.remove('modal-hidden');
                return;
            }

            window.location.href = '/';
        } catch (err) {
            errorEl.textContent = err.message;
            errorEl.classList.remove('modal-hidden');
        }
    });

    document.getElementById('grade-edit-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const errorEl = document.getElementById('grade-edit-error');

        try {
            const response = await fetch('/api/settings/grade', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    grade: formData.get('grade'),
                    password: formData.get('password')
                })
            });

            const data = await response.json();

            if (!response.ok) {
                errorEl.textContent = data.error || '修改失败';
                errorEl.classList.remove('modal-hidden');
                return;
            }

            window.location.reload();
        } catch (err) {
            errorEl.textContent = err.message;
            errorEl.classList.remove('modal-hidden');
        }
    });

    document.getElementById('class-edit-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const errorEl = document.getElementById('class-edit-error');

        try {
            const response = await fetch('/api/settings/class', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    class_name: formData.get('class_name'),
                    password: formData.get('password')
                })
            });

            const data = await response.json();

            if (!response.ok) {
                errorEl.textContent = data.error || '修改失败';
                errorEl.classList.remove('modal-hidden');
                return;
            }

            window.location.reload();
        } catch (err) {
            errorEl.textContent = err.message;
            errorEl.classList.remove('modal-hidden');
        }
    });
    </script>

    <style>
    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }
    .info-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .info-label {
        font-size: 0.75rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .info-value {
        font-size: 1rem;
        color: var(--foreground);
    }
    .quota-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }
    .quota-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .quota-label {
        font-size: 0.75rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .quota-value {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--foreground);
    }
    .level-display {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .level-badge {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 700;
        color: white;
    }
    .level-name {
        font-size: 1.25rem;
        font-weight: 600;
    }
    .credit-display {
        display: flex;
        gap: 2rem;
    }
    .credit-item {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .credit-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--primary);
    }
    .credit-label {
        font-size: 0.875rem;
        color: var(--muted);
    }
    .upgrade-progress {
        margin-top: 1.5rem;
        padding: 1rem;
        background: var(--surface-hover);
        border-radius: 0.5rem;
    }
    .progress-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        font-size: 0.875rem;
    }
    .progress-bar {
        height: 8px;
        background: var(--line);
        border-radius: 4px;
        overflow: hidden;
    }
    .progress-fill {
        height: 100%;
        background: var(--primary);
        transition: width 0.3s ease;
    }
    .progress-footer {
        display: flex;
        justify-content: space-between;
        margin-top: 0.5rem;
        font-size: 0.75rem;
        color: var(--muted);
    }
    .max-level-notice {
        margin-top: 1rem;
        padding: 0.75rem;
        background: rgba(245, 158, 11, 0.1);
        border-radius: 0.5rem;
        color: var(--warning);
        text-align: center;
        font-weight: 600;
    }
    .permissions-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .permissions-list li {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
    }
    .permission-check {
        color: var(--success);
        font-weight: 700;
    }
    .permission-lock {
        opacity: 0.5;
    }
    .level-grid {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .level-item {
        padding: 0.75rem;
        background: var(--surface-hover);
        border-radius: 0.5rem;
        border: 2px solid transparent;
    }
    .level-item.current {
        border-color: var(--primary);
        background: rgba(59, 130, 246, 0.05);
    }
    .level-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }
    .level-badge-small {
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        font-weight: 700;
        color: white;
    }
    .level-requirement {
        font-size: 0.75rem;
        color: var(--muted);
    }
    .level-permissions {
        margin: 0;
        padding-left: 1rem;
        font-size: 0.75rem;
        color: var(--text);
    }
    .level-permissions li {
        margin-bottom: 0.25rem;
    }
    .history-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        max-height: 300px;
        overflow-y: auto;
    }
    .history-item {
        padding: 0.75rem;
        background: var(--surface-hover);
        border-radius: 0.5rem;
    }
    .history-main {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .history-delta {
        font-weight: 700;
        font-size: 1.125rem;
    }
    .history-delta.positive {
        color: var(--success);
    }
    .history-delta.negative {
        color: var(--danger);
    }
    .history-reason {
        color: var(--foreground);
    }
    .history-meta {
        display: flex;
        gap: 1rem;
        margin-top: 0.25rem;
        font-size: 0.75rem;
        color: var(--muted);
