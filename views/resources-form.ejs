<%- include('partials/header') %>
    <section class="page-title">
        <span class="eyebrow" data-i18n="resources.uploadTitle">上传资源</span>
        <h1 data-i18n="resources.uploadTitle">上传资源</h1>
    </section>

    <section class="layout-grid">
        <article class="card section-card">
            <% if (errors && errors.length) { %>
                <div class="error-list">
                    <% errors.forEach(error => { %>
                        <div class="flash flash-error"><%= error %></div>
                    <% }) %>
                </div>
            <% } %>

            <form class="form-grid" action="/resources" method="POST" enctype="multipart/form-data">
                <label class="form-group">
                    <span class="form-label" data-i18n="resources.selectSubject">选择学科</span>
                    <select name="board_id" class="form-control" required>
                        <option value="" data-i18n="resources.selectSubject">选择学科</option>
                        <% boards.forEach(board => { %>
                            <option value="<%= board.id %>"><%= (locale === 'en' && board.name_en) ? board.name_en : board.name %></option>
                        <% }) %>
                    </select>
                </label>

                <label class="form-group">
                    <span class="form-label" data-i18n="resources.resourceTitle">资源标题</span>
                    <input class="form-control" type="text" name="title" data-i18n-placeholder="resources.titlePlaceholder" placeholder="" required>
                </label>

                <label class="form-group">
                    <span class="form-label" data-i18n="resources.description">资源描述</span>
                    <textarea class="form-control" name="description" rows="5" data-i18n-placeholder="resources.descPlaceholder" placeholder=""></textarea>
                </label>

                <label class="form-group">
                    <span class="form-label" data-i18n="resources.resourceType">资源类型</span>
                    <select name="resource_type" id="resource-type-select" class="form-control" required onchange="handleResourceTypeChange()">
                        <option value="" data-i18n="resources.selectType">请选择</option>
                        <option value="external" data-i18n="resources.externalLink">外部链接</option>
                        <option value="file" data-i18n="resources.fileType">文件</option>
                    </select>
                </label>

                <label class="form-group" id="external-url-group" style="display: none;">
                    <span class="form-label" data-i18n="resources.externalUrl">外部链接</span>
                    <input class="form-control" type="url" name="external_url" id="external-url-input" data-i18n-placeholder="resources.urlPlaceholder" placeholder="">
                </label>

                <label class="form-group" id="file-upload-group" style="display: none;">
                    <span class="form-label" data-i18n="resources.uploadFile">上传文件</span>
                    <input class="form-control" type="file" name="resourceFile" id="file-upload-input" accept=".pdf,.ppt,.pptx,.doc,.docx,.png,.jpg,.jpeg">
                    <span class="helper-text" data-i18n="resources.maxFileSize">最大支持 100MB</span>
                </label>

                <p class="helper-text" data-i18n="resources.uploadNote">发布后会经过人工审核，请耐心等待。</p>

                <div class="action-row">
                    <button class="btn btn-primary" type="submit" data-i18n="resources.submitResource">提交资源</button>
                    <a class="btn btn-ghost" href="/resources" data-i18n="common.cancel">取消</a>
                </div>
            </form>
        </article>
    </section>

    <script>
    function handleResourceTypeChange() {
        var select = document.getElementById('resource-type-select');
        var externalGroup = document.getElementById('external-url-group');
        var fileGroup = document.getElementById('file-upload-group');
        var externalInput = document.getElementById('external-url-input');
        var fileInput = document.getElementById('file-upload-input');

        if (select.value === 'external') {
            externalGroup.style.display = 'block';
            fileGroup.style.display = 'none';
            externalInput.required = true;
            fileInput.required = false;
            fileInput.value = '';
        } else if (select.value === 'file') {
            externalGroup.style.display = 'none';
            fileGroup.style.display = 'block';
            externalInput.required = false;
            externalInput.value = '';
            fileInput.required = true;
        } else {
            externalGroup.style.display = 'none';
            fileGroup.style.display = 'none';
            externalInput.required = false;
            fileInput.required = false;
        }
    }
    </script>
<%- include('partials/footer') %>
