<%- include('partials/header') %>
    <section class="auth-shell">
        <article class="card auth-card">
            <span class="eyebrow" data-i18n="auth.welcomeBack">欢迎回来</span>
            <h1 data-i18n="auth.loginTitle">登录 BG Hub</h1>
            <p class="helper-text">使用学校邮箱或 Gmail 登录，继续管理 CJ、作业与学习社区。</p>

            <% if (errors && errors.length) { %>
                <div class="error-list">
                    <% errors.forEach(error => { %>
                        <div class="flash flash-error"><%= error %></div>
                    <% }) %>
                </div>
            <% } %>

            <form action="/login" method="POST" class="form-grid">
                <label class="form-group">
                    <span class="form-label">邮箱</span>
                    <input type="email" name="email" class="form-control" placeholder="name@basischina.com" required>
                </label>
                <label class="form-group">
                    <span class="form-label">密码</span>
                    <input type="password" name="password" class="form-control" placeholder="至少 8 位" required>
                </label>
                <button type="submit" class="btn btn-primary btn-block" data-i18n="auth.loginButton">登录</button>
            </form>

            <div class="auth-footer">
                <span>还没有账号？</span>
                <a href="/register" class="text-link">立即注册</a>
            </div>
        </article>
    </section>
<%- include('partials/footer') %>
