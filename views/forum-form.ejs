<%- include('partials/header') %>
    <section class="page-title">
        <span class="eyebrow" data-i18n="forum.forumEditor">Forum Editor</span>
        <h1 data-i18n="forum.<%= mode === 'edit' ? 'editPost' : 'createPost' %>"><%= mode === 'edit' ? '编辑帖子' : '发布帖子' %></h1>
        <p data-i18n="forum.editorDescription">正文使用 Markdown 输入。</p>
    </section>

    <section class="layout-grid">
        <article class="card section-card">
            <% if (errors && errors.length) { %>
                <div class="error-list">
                    <% errors.forEach(error => { %>
                        <div class="flash flash-error"><%= error %></div>
                    <% }) %>
                </div>
            <% } %>

            <form class="form-grid" action="<%= mode === 'edit' ? `/forum/${post.id}/edit` : '/forum/posts' %>" method="POST">
                <label class="form-group">
                    <span class="form-label" data-i18n="forum.boardLabel">学科板块</span>
                    <select name="board_id" class="form-control">
                        <option value="" data-i18n="forum.selectBoard">选择学科（可选）</option>
                        <% boards.forEach(board => { %>
                            <option value="<%= board.id %>" <%= post && Number(post.board_id) === board.id ? 'selected' : '' %>><%= (locale === 'en' && board.name_en) ? board.name_en : board.name %></option>
                        <% }) %>
                    </select>
                </label>

                <label class="form-group">
                    <span class="form-label" data-i18n="forum.titleLabel">标题</span>
                    <input class="form-control" type="text" name="title" value="<%= post ? post.title : '' %>" data-i18n-placeholder="forum.titlePlaceholder" placeholder="" required>
                </label>

                <label class="form-group">
                    <span class="form-label" data-i18n="forum.contentLabel">正文</span>
                    <textarea class="form-control" name="content" rows="12" data-i18n-placeholder="forum.contentPlaceholder" placeholder="" required><%= post ? post.content : '' %></textarea>
                </label>

                <div class="action-row">
                    <button class="btn btn-primary" type="submit" data-i18n="forum.<%= mode === 'edit' ? 'savePost' : 'publishSubmit' %>"><%= mode === 'edit' ? '保存修改' : '发布帖子' %></button>
                    <a class="btn btn-ghost" href="/forum" data-i18n="common.cancel">取消</a>
                </div>
            </form>
        </article>

        <aside class="sidebar-stack">
            <article class="card section-card">
                <h3 data-i18n="forum.postingTips">发布建议</h3>
                <ul class="mini-list">
                    <li><span>1</span><span data-i18n="forum.tip1">标题尽量描述清楚题目、章节或资源用途</span></li>
                    <li><span>2</span><span data-i18n="forum.tip2">Markdown 支持列表、代码块与链接</span></li>
                </ul>
            </article>
        </aside>
    </section>
<%- include('partials/footer') %>
