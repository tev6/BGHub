    }
    .tab-btn:not(.is-active) .tab-count {
        background: var(--surface-alt);
        color: var(--text-secondary);
    }
    .review-filters {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }
    .form-control-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }
    .review-item {
        display: flex;
        gap: 1rem;
        padding: 1rem;
        margin-bottom: 0.5rem;
    }
    .review-item-icon {
        font-size: 1.5rem;
