        align-items: flex-start;
    }
    .icon-appeal {
        font-size: 1.5rem;
    }
    .review-drawer {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1000;
        display: flex;
        justify-content: flex-end;
    }
    .review-drawer[hidden] {
        display: none !important;
    }
    .drawer-backdrop {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5);
    }
    .drawer-content {
        position: relative;
        width: 90%;
        max-width: 600px;
        background: var(--surface);
        height: 100%;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }
    .drawer-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        border-bottom: 1px solid var(--line);
    }
    .drawer-body {
        flex: 1;
        padding: 1rem;
        overflow-y: auto;
    }
    .drawer-footer {
        padding: 1rem;
        border-top: 1px solid var(--line);
    }
    .detail-section {
        margin-bottom: 1.5rem;
    }
    .detail-section h3 {
        font-size: 1rem;
        margin-bottom: 0.5rem;
        color: var(--primary);
    }
    .rule-hint {
        background: var(--surface-alt);
        padding: 0.75rem;
        border-radius: 0.5rem;
        margin-bottom: 1rem;
        display: flex;
        gap: 0.5rem;
        align-items: flex-start;
        font-size: 0.875rem;
    }
    .hint-icon {
        flex-shrink: 0;
    }
    .modal {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1100;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .modal[hidden] {
        display: none !important;
    }
    .modal-backdrop {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5);
    }
    .modal-content {
        position: relative;
        width: 90%;
        max-width: 700px;
        max-height: 90vh;
        background: var(--surface);
        border-radius: 0.5rem;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        border-bottom: 1px solid var(--line);
    }
    .modal-body {
        padding: 1rem;
        overflow-y: auto;
    }
    .info-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1rem;
        font-size: 0.875rem;
    }
    .info-table th,
    .info-table td {
        padding: 0.5rem;
        border: 1px solid var(--line);
        text-align: left;
    }
    .info-table th {
        background: var(--surface-alt);
    }
    .level-tag {
        background: var(--primary);
        color: white;
        padding: 0.1rem 0.4rem;
        border-radius: 0.25rem;
        font-weight: bold;
    }
    .info-note {
        background: var(--surface-alt);
        padding: 1rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
    }
    .info-note ul {
        margin: 0.5rem 0 0 1.5rem;
    }
    .info-note li {
        margin-bottom: 0.25rem;
    }
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
    }
    .page-info {
        color: var(--text-secondary);
    }
    .report-reason {
        font-size: 0.875rem;
        color: var(--danger);
        margin-top: 0.25rem;
    }
    .status-tag {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        font-weight: 500;
    }
    .status-pending {
        background: var(--surface-alt);
        color: var(--text-secondary);
    }
    .status-info {
        background: #dbeafe;
        color: #1e40af;
    }
    .status-warning {
        background: #fef3c7;
        color: #92400e;
    }
    .status-primary {
        background: #dbeafe;
        color: #1d4ed8;
    }
    .status-success {
        background: #d1fae5;
        color: #065f46;
    }
    .status-danger {
        background: #fee2e2;
        color: #991b1b;
    }
    [data-theme="dark"] .status-info {
        background: #1e3a5f;
        color: #93c5fd;
    }
    [data-theme="dark"] .status-warning {
        background: #422006;
        color: #fcd34d;
    }
    [data-theme="dark"] .status-primary {
        background: #1e3a5f;
        color: #93c5fd;
    }
    [data-theme="dark"] .status-success {
        background: #064e3b;
        color: #6ee7b7;
    }
    [data-theme="dark"] .status-danger {
        background: #7f1d1d;
        color: #fca5a5;
    }
    </style>

    <script>
    (function() {
        var currentTab = 'pending';
        var currentPage = 1;
        var totalPages = 1;
        var currentItemId = null;
        var currentItemType = null;

        var tabBtns = document.querySelectorAll('.tab-btn');
        var tabContents = document.querySelectorAll('[data-tab-content]');
        var drawer = document.querySelector('[data-review-drawer]');
        var drawerBody = document.querySelector('[data-drawer-body]');
        var drawerFooter = document.querySelector('[data-drawer-footer]');
        var pagination = document.querySelector('[data-pagination]');
        var reviewReasonInput = document.querySelector('[data-review-reason]');
        var levelInfoModal = document.getElementById('level-info-modal');

        function showLevelInfo() {
            if (levelInfoModal) {
                levelInfoModal.removeAttribute('hidden');
            }
        }

        function hideLevelInfo() {
            if (levelInfoModal) {
                levelInfoModal.setAttribute('hidden', '');
            }
        }

        window.showLevelInfo = showLevelInfo;
        window.hideLevelInfo = hideLevelInfo;

        function switchTab(tab) {
            currentTab = tab;
            currentPage = 1;
            tabBtns.forEach(function(b) {
                b.classList.toggle('is-active', b.getAttribute('data-tab') === tab);
            });
            tabContents.forEach(function(content) {
                content.setAttribute('hidden', '');
                if (content.getAttribute('data-tab-content') === tab) {
                    content.removeAttribute('hidden');
                }
            });
            loadData();
        }

        tabBtns.forEach(function(btn) {
            btn.addEventListener('click', function() {
                switchTab(this.getAttribute('data-tab'));
            });
        });

        document.querySelectorAll('[data-drawer-close]').forEach(function(btn) {
            btn.addEventListener('click', function() {
                drawer.setAttribute('hidden', '');
                drawerFooter.setAttribute('hidden', '');
                currentItemId = null;
            });
        });

        document.querySelectorAll('[data-modal-close]').forEach(function(btn) {
            btn.addEventListener('click', function() {
                if (levelInfoModal) {
                    levelInfoModal.setAttribute('hidden', '');
                }
            });
        });

        if (levelInfoModal) {
            var backdrop = levelInfoModal.querySelector('.modal-backdrop');
            if (backdrop) {
                backdrop.addEventListener('click', function() {
                    levelInfoModal.setAttribute('hidden', '');
                });
            }
        }

        function loadData() {
            var list = document.querySelector('[data-tab-content="' + currentTab + '"]');
            var loading = list.querySelector('.review-loading');
            var empty = list.querySelector('.review-empty');
            var items = list.querySelectorAll('.review-item');

            items.forEach(function(i) { i.remove(); });
            loading.removeAttribute('hidden');
            empty.setAttribute('hidden', '');
            pagination.setAttribute('hidden', '');

            var apiUrl = '';
            var typeFilter = document.getElementById('filter-type')?.value || '';
            var statusFilter = document.getElementById('filter-status')?.value || 'pending';

            if (currentTab === 'pending') {
                apiUrl = '/api/review/items?page=' + currentPage + '&status=' + statusFilter;
                if (typeFilter) apiUrl += '&type=' + typeFilter;
            } else if (currentTab === 'appeals') {
                apiUrl = '/api/review/appeals/list?page=' + currentPage;
            } else if (currentTab === 'ai-reviewing') {
                apiUrl = '/api/review/ai-reviewing?page=' + currentPage;
                if (typeFilter) apiUrl += '&type=' + typeFilter;
            } else if (currentTab === 'reports') {
                apiUrl = '/api/reports/list?page=' + currentPage + '&status=' + statusFilter;
            } else if (currentTab === 'ai-reviewing') {
                apiUrl = '/api/review/ai-reviewing?page=' + currentPage;
                if (typeFilter) apiUrl += '&type=' + typeFilter;
            }

            fetch(apiUrl)
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    loading.setAttribute('hidden', '');
                    if (currentTab === 'pending') {
                        updateCountBadge('pending', data.pagination?.totalItems || 0);
                        if (data.items && data.items.length) {
                            renderItems(list, data.items, 'item');
                            if (data.pagination && data.pagination.totalPages > 1) {
                                totalPages = data.pagination.totalPages;
                                updatePagination();
                                pagination.removeAttribute('hidden');
                            }
                        } else {
                            empty.removeAttribute('hidden');
                        }
                    } else if (currentTab === 'appeals') {
                        updateCountBadge('appeals', data.pagination?.totalItems || 0);
                        if (data.appeals && data.appeals.length) {
                            renderItems(list, data.appeals, 'appeal');
                            if (data.pagination && data.pagination.totalPages > 1) {
                                totalPages = data.pagination.totalPages;
                                updatePagination();
                                pagination.removeAttribute('hidden');
                            }
                        } else {
                            empty.removeAttribute('hidden');
                        }
                    } else if (currentTab === 'ai-reviewing') {
                        updateCountBadge('ai-reviewing', data.pagination?.totalItems || 0);
                        if (data.items && data.items.length) {
                            renderItems(list, data.items, 'item');
                            if (data.pagination && data.pagination.totalPages > 1) {
                                totalPages = data.pagination.totalPages;
                                updatePagination();
                                pagination.removeAttribute('hidden');
                            }
                        } else {
                            empty.removeAttribute('hidden');
                        }
                    } else if (currentTab === 'reports') {
                        updateCountBadge('reports', data.pagination?.totalItems || 0);
                        if (data.reports && data.reports.length) {
                            renderItems(list, data.reports, 'report');
                            if (data.pagination && data.pagination.totalPages > 1) {
                                totalPages = data.pagination.totalPages;
                                updatePagination();
                                pagination.removeAttribute('hidden');
                            }
                        } else {
                            empty.removeAttribute('hidden');
                        }
                    }
                })
                .catch(function(err) {
                    console.error('Load error:', err);
                    loading.setAttribute('hidden', '');
                    empty.removeAttribute('hidden');
                });
        }

        function updateCountBadge(tab, count) {
            var badge = document.querySelector('[data-count="' + tab + '"]');
            if (badge) badge.textContent = count;
        }

        function updatePagination() {
            document.querySelector('[data-page-current]').textContent = currentPage;
            document.querySelector('[data-page-total]').textContent = totalPages;
            document.querySelector('[data-page-prev]').disabled = currentPage <= 1;
            document.querySelector('[data-page-next]').disabled = currentPage >= totalPages;
        }

        function renderItems(container, items, type) {
            items.forEach(function(item) {
                var div = document.createElement('div');
                div.className = 'review-item card';

                var icon = '';
                var typeLabel = '';
                var authorName = '';
                var content = '';
                var time = '';
                var id = '';

                if (type === 'item') {
                    icon = item.item_type === 'post' ? '📝' : item.item_type === 'chat' ? '💬' : '📎';
                    typeLabel = item.item_type === 'post' ? '帖子' : item.item_type === 'chat' ? '聊天' : '资源';
                    authorName = item.author_name || '未知';
                    content = item.payload || '';
                    time = item.created_at;
                    id = item.id;
                    
                    var stageLabel = item.stage_label || getStageLabel(item.review_stage);
                    var stageClass = getStageClass(item.review_stage);

                    div.innerHTML = '<div class="review-item-icon"><span>' + icon + '</span></div>' +
                        '<div class="review-item-body">' +
                        '<div class="review-item-meta">' +
                        '<span class="tag">' + typeLabel + '</span>' +
                        '<span class="status-tag ' + stageClass + '">' + stageLabel + '</span>' +
                        '<span>' + authorName + '</span>' +
                        '<span>' + new Date(time).toLocaleString() + '</span>' +
                        '</div>' +
                        '<p class="review-item-preview">' + escapeHtml(content) + '</p>' +
                        '</div>' +
                        '<div class="review-item-actions">' +
                        (item.review_stage === 'pending_human' ? 
                        '<button class="btn btn-primary btn-sm" type="button" data-action="approve" data-id="' + id + '">通过</button>' +
                        '<button class="btn btn-danger btn-sm" type="button" data-action="reject" data-id="' + id + '">驳回</button>' : '') +
                        '<button class="btn btn-ghost btn-sm" type="button" data-action="detail" data-id="' + id + '">详情</button>' +
                        '</div>';
                } else if (type === 'appeal') {
                    icon = '⚖️';
                    typeLabel = item.content_type || '未知';
                    authorName = item.author_name || '未知';
                    content = item.appeal_reason || '';
                    time = item.created_at;
                    id = item.id;

                    div.innerHTML = '<div class="review-item-icon"><span>' + icon + '</span></div>' +
                        '<div class="review-item-body">' +
                        '<div class="review-item-meta">' +
                        '<span class="tag">申诉-' + typeLabel + '</span>' +
                        '<span>' + authorName + '</span>' +
                        '<span>' + new Date(time).toLocaleString() + '</span>' +
                        '</div>' +
                        '<p class="review-item-preview">' + escapeHtml(content) + '</p>' +
                        '</div>' +
                        '<div class="review-item-actions">' +
                        '<button class="btn btn-primary btn-sm" type="button" data-action="appeal-approve" data-id="' + id + '">批准</button>' +
                        '<button class="btn btn-danger btn-sm" type="button" data-action="appeal-reject" data-id="' + id + '">驳回</button>' +
                        '</div>';
                } else if (type === 'report') {
                    icon = '🚩';
                    typeLabel = item.target_type || '未知';
                    authorName = item.reporter_name || '举报人';
                    content = item.reason || '';
                    time = item.created_at;
                    id = item.id;

                    div.innerHTML = '<div class="review-item-icon"><span>' + icon + '</span></div>' +
                        '<div class="review-item-body">' +
                        '<div class="review-item-meta">' +
                        '<span class="tag">举报-' + typeLabel + '</span>' +
                        '<span>举报人: ' + authorName + '</span>' +
                        '<span>' + new Date(time).toLocaleString() + '</span>' +
                        '</div>' +
                        '<p class="review-item-preview report-reason">举报原因: ' + escapeHtml(content) + '</p>' +
                        '</div>' +
                        '<div class="review-item-actions">' +
                        '<button class="btn btn-ghost btn-sm" type="button" data-action="report-detail" data-id="' + id + '">详情</button>' +
                        '<button class="btn btn-primary btn-sm" type="button" data-action="report-verify" data-id="' + id + '">成立</button>' +
                        '<button class="btn btn-danger btn-sm" type="button" data-action="report-dismiss" data-id="' + id + '">不成立</button>' +
                        '</div>';
                }

                container.appendChild(div);
            });

            container.querySelectorAll('[data-action]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var action = this.getAttribute('data-action');
                    var id = this.getAttribute('data-id');
                    handleAction(action, id);
                });
            });
        }

        function handleAction(action, id) {
            if (action === 'detail' || action === 'report-detail') {
                showDetail(id, action === 'report-detail' ? 'report' : 'item');
                return;
            }

            var reason = prompt('请输入审核理由（10-200字）：');
            if (!reason || reason.length < 10) {
                alert('审核理由需要在10-200字之间');
                return;
            }

            var apiUrl = '';
            var bodyData = {};

            if (action === 'approve') {
                apiUrl = '/api/review/items/' + id + '/approve';
                bodyData = { reason: reason };
            } else if (action === 'reject') {
                apiUrl = '/api/review/items/' + id + '/reject';
                bodyData = { reason: reason };
            } else if (action === 'appeal-approve') {
                apiUrl = '/api/review/' + id + '/appeal-decide';
                bodyData = { decision: 'approve', review_note: reason };
            } else if (action === 'appeal-reject') {
                apiUrl = '/api/review/' + id + '/appeal-decide';
                bodyData = { decision: 'reject', review_note: reason };
            } else if (action === 'report-verify') {
                apiUrl = '/api/reports/' + id + '/verify';
                bodyData = { reason: reason };
            } else if (action === 'report-dismiss') {
                apiUrl = '/api/reports/' + id + '/dismiss';
                bodyData = { reason: reason };
            }

            fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(bodyData)
            })
            .then(function(res) { return res.json(); })
            .then(function(result) {
                if (result.error) {
                    alert(result.error);
                } else {
                    alert(result.message || '操作成功');
                    loadData();
                }
            })
            .catch(function(err) {
                console.error('Action error:', err);
                alert('操作失败，请稍后重试');
            });
        }

        function showDetail(id, type) {
            currentItemId = id;
            drawerBody.innerHTML = '<p>加载中...</p>';
            drawer.removeAttribute('hidden');

            if (type === 'report') {
                showReportDetail(id);
                return;
            }

            drawerFooter.removeAttribute('hidden');

            fetch('/api/review/items/' + id)
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data.error) {
                        drawerBody.innerHTML = '<p class="error">' + data.error + '</p>';
                        return;
                    }
                    var item = data.item;
                    var content = data.content;
                    var html = '<div class="detail-section">';
                    html += '<h3>审核项信息</h3>';
                    html += '<p><strong>类型：</strong>' + (item.item_type === 'post' ? '帖子' : item.item_type === 'chat' ? '聊天消息' : '资源') + '</p>';
                    html += '<p><strong>提交者：</strong>' + (item.author_name || '未知') + '</p>';
                    html += '<p><strong>时间：</strong>' + new Date(item.created_at).toLocaleString() + '</p>';
                    html += '<p><strong>状态：</strong>' + item.status + '</p>';
                    html += '</div>';
                    if (content) {
                        html += '<div class="detail-section">';
                        html += '<h3>内容详情</h3>';
                        if (item.item_type === 'post' || item.item_type === 'resource') {
                            html += '<p><strong>标题：</strong>' + escapeHtml(content.title || '') + '</p>';
                            html += '<div class="markdown-body">' + (content.content || content.description || '') + '</div>';
                        } else if (item.item_type === 'chat') {
                            html += '<div class="chat-bubble"><p>' + escapeHtml(content.content || '') + '</p></div>';
                        }
                        html += '</div>';
                    }
                    if (data.history && data.history.length) {
                        html += '<div class="detail-section">';
                        html += '<h3>审核历史</h3>';
                        data.history.forEach(function(h) {
                            html += '<p><strong>' + (h.reviewer_name || '未知') + '</strong>: ' + h.action + ' - ' + (h.notes || h.reason || '') + ' (' + new Date(h.created_at).toLocaleString() + ')</p>';
                        });
                        html += '</div>';
                    }
                    drawerBody.innerHTML = html;
                })
                .catch(function(err) {
                    console.error('Load detail error:', err);
                    drawerBody.innerHTML = '<p class="error">加载详情失败</p>';
                });
        }

        function showReportDetail(id) {
            drawerFooter.setAttribute('hidden', '');
            fetch('/api/reports/' + id)
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data.error) {
                        drawerBody.innerHTML = '<p class="error">' + data.error + '</p>';
                        return;
                    }
                    var report = data.report || data;
                    var html = '<div class="detail-section">';
                    html += '<h3>举报信息</h3>';
                    html += '<table class="info-table">';
                    html += '<tr><th>举报人</th><td>' + escapeHtml(report.reporter_name || '未知') + '</td></tr>';
                    html += '<tr><th>被举报人</th><td>' + escapeHtml(report.target_name || '未知') + ' (LV' + (report.target_role_level || '?') + ')</td></tr>';
                    html += '<tr><th>举报类型</th><td>' + getTargetTypeLabel(report.target_type) + '</td></tr>';
                    html += '<tr><th>举报时间</th><td>' + new Date(report.created_at).toLocaleString() + '</td></tr>';
                    html += '<tr><th>举报原因</th><td>' + escapeHtml(report.reason || '无') + '</td></tr>';
                    html += '<tr><th>状态</th><td>' + getReportStatusLabel(report.status) + '</td></tr>';
                    html += '</table>';
                    html += '</div>';

                    if (report.target_type === 'post' && report.target_id) {
                        html += '<div class="detail-section">';
                        html += '<h3>被举报内容</h3>';
                        html += '<p><a href="/forum/' + report.target_id + '" target="_blank" class="btn btn-ghost btn-sm">查看原帖</a></p>';
                        html += '</div>';
                    } else if (report.target_type === 'chat' && report.target_id) {
                        html += '<div class="detail-section">';
                        html += '<h3>被举报内容</h3>';
                        html += '<p><a href="/chat" class="btn btn-ghost btn-sm">查看聊天记录</a></p>';
                        html += '</div>';
                    }

                    if (report.reviewer_name) {
                        html += '<div class="detail-section">';
                        html += '<h3>处理信息</h3>';
                        html += '<p><strong>处理人：</strong>' + escapeHtml(report.reviewer_name) + '</p>';
                        html += '<p><strong>处理时间：</strong>' + new Date(report.reviewed_at).toLocaleString() + '</p>';
                        html += '<p><strong>处理结果：</strong>' + escapeHtml(report.review_result || '') + '</p>';
                        html += '</div>';
                    }

                    drawerBody.innerHTML = html;
                })
                .catch(function(err) {
                    console.error('Load report detail error:', err);
                    drawerBody.innerHTML = '<p class="error">加载详情失败</p>';
                });
        }

        function getTargetTypeLabel(type) {
            var labels = {
                'post': '帖子/笔记',
                'comment': '评论',
                'chat': '聊天消息',
                'resource': '资源',
                'cj': 'CJ内容'
            };
            return labels[type] || type || '未知';
        }

        function getReportStatusLabel(status) {
            var labels = {
                'pending': '待处理',
                'verified': '已成立',
                'dismissed': '已驳回'
            };
            return labels[status] || status || '未知';
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function getStageLabel(stage) {
            var labels = {
                'pending_ai': '等待AI审核',
                'ai_reviewing': 'AI审核中',
                'ai_rejected': 'AI审核未通过',
                'pending_human': '等待人工审核',
                'approved': '已通过',
                'rejected': '已驳回'
            };
            return labels[stage] || stage || '待审核';
        }

        function getStageClass(stage) {
            var classes = {
                'pending_ai': 'status-pending',
                'ai_reviewing': 'status-info',
                'ai_rejected': 'status-warning',
                'pending_human': 'status-primary',
                'approved': 'status-success',
                'rejected': 'status-danger'
            };
            return classes[stage] || 'status-pending';
        }

        var pollInterval = null;
        
        function startPolling() {
            if (pollInterval) return;
            pollInterval = setInterval(function() {
                loadData();
            }, 30000);
        }

        function stopPolling() {
            if (pollInterval) {
                clearInterval(pollInterval);
                pollInterval = null;
            }
        }

        document.addEventListener('visibilitychange', function() {
            if (document.hidden) {
                stopPolling();
            } else {
                startPolling();
            }
        });

        function loadStats() {
            fetch('/api/review/stats')
                .then(function(res) { return res.json(); })
                .then(function(stats) {
                    updateCountBadge('pending', stats.pending_human || 0);
                    updateCountBadge('appeals', stats.ai_rejected || 0);
                    updateCountBadge('ai-reviewing', (stats.pending_ai || 0) + (stats.ai_reviewing || 0));
                })
                .catch(function(err) {
                    console.error('Load stats error:', err);
                });

            fetch('/api/reports/stats')
                .then(function(res) { return res.json(); })
                .then(function(stats) {
                    updateCountBadge('reports', stats.pending || 0);
                })
                .catch(function(err) {
                    console.error('Load report stats error:', err);
                });
        }

        startPolling();
        loadStats();

        document.querySelector('[data-page-prev]')?.addEventListener('click', function() {
            if (currentPage > 1) {
                currentPage--;
                loadData();
            }
        });

        document.querySelector('[data-page-next]')?.addEventListener('click', function() {
            if (currentPage < totalPages) {
                currentPage++;
                loadData();
            }
        });

        document.getElementById('filter-type')?.addEventListener('change', loadData);
        document.getElementById('filter-status')?.addEventListener('change', loadData);

        document.querySelector('[data-confirm-approve]')?.addEventListener('click', function() {
            if (currentItemId) {
                handleAction('approve', currentItemId);
                drawer.setAttribute('hidden', '');
            }
        });

        document.querySelector('[data-confirm-reject]')?.addEventListener('click', function() {
            if (currentItemId) {
                handleAction('reject', currentItemId);
                drawer.setAttribute('hidden', '');
            }
        });

        loadData();
    })();
    </script>
<%- include('partials/footer') %>
