<%- include('partials/header') %>
    <div class="review-layout">
        <div class="review-header">
            <h1 data-i18n="review.title">审核面板</h1>
            <div class="level-badge">
                <span class="helper-text">LV</span><span class="level-number"><%= locals.user ? locals.user.role_level : 0 %></span>
                <button type="button" class="btn btn-ghost btn-xs" onclick="showLevelInfo()" title="等级说明">❓</button>
            </div>
        </div>

        <div class="review-tabs">
            <button class="tab-btn is-active" data-tab="pending" data-i18n="review.tabPending">
                待人工审核 <span class="tab-count" data-count="pending">0</span>
            </button>
            <button class="tab-btn" data-tab="appeals" data-i18n="review.tabAppeals">
                申诉队列 <span class="tab-count" data-count="appeals">0</span>
            </button>
            <% if (user && user.role_level >= 3) { %>
            <button class="tab-btn" data-tab="ai-reviewing" data-i18n="review.tabAiReviewing">
                AI审核中 <span class="tab-count" data-count="ai-reviewing">0</span>
            </button>
            <% } %>
            <% if (user && user.role_level >= 4) { %>
            <button class="tab-btn" data-tab="reports" data-i18n="review.tabReports">
                举报管理 <span class="tab-count" data-count="reports">0</span>
            </button>
            <% } %>
        </div>

        <div class="review-filters" data-tab-content="pending">
            <select id="filter-type" class="form-control form-control-sm">
                <option value="">全部类型</option>
                <option value="chat">聊天消息</option>
                <option value="post">帖子/笔记</option>
                <option value="resource">资源</option>
                <option value="homework">作业</option>
            </select>
            <select id="filter-status" class="form-control form-control-sm">
                <option value="pending">待处理</option>
                <option value="approved">已通过</option>
                <option value="rejected">已驳回</option>
            </select>
        </div>

        <div class="review-list" data-review-list data-tab-content="pending">
            <div class="review-loading" hidden>
                <span>加载中...</span>
            </div>
            <div class="review-empty" hidden>
                <div class="empty-state" data-i18n="review.noItems">暂无待审核内容</div>
            </div>
        </div>

        <div class="review-list" data-review-list data-tab-content="appeals" hidden>
            <div class="review-loading" hidden>
                <span>加载中...</span>
            </div>
            <div class="review-empty" hidden>
                <div class="empty-state" data-i18n="review.noAppeals">暂无申诉</div>
            </div>
        </div>

        <div class="review-list" data-review-list data-tab-content="ai-reviewing" hidden>
            <div class="review-loading" hidden>
                <span>加载中...</span>
            </div>
            <div class="review-empty" hidden>
                <div class="empty-state">暂无AI审核中的内容</div>
            </div>
            <div class="ai-reviewing-notice" style="padding: 0.5rem; background: var(--surface); border-radius: 0.25rem; margin-bottom: 0.5rem;">
                <span class="helper-text">ℹ️ AI审核中的内容仅供查看，无法进行操作</span>
            </div>
        </div>

        <% if (user && user.role_level >= 4) { %>
        <div class="review-list" data-review-list data-tab-content="reports" hidden>
            <div class="review-loading" hidden>
                <span>加载中...</span>
            </div>
            <div class="review-empty" hidden>
                <div class="empty-state" data-i18n="review.noReports">暂无举报</div>
            </div>
        </div>
        <% } %>

        <div class="pagination" data-pagination hidden>
            <button class="btn btn-ghost btn-sm" data-page-prev data-i18n="common.prevPage">上一页</button>
            <span class="page-info"><span data-page-current>1</span> / <span data-page-total>1</span></span>
            <button class="btn btn-ghost btn-sm" data-page-next data-i18n="common.nextPage">下一页</button>
        </div>
    </div>

    <div class="review-drawer" data-review-drawer hidden>
        <div class="drawer-backdrop" data-drawer-close></div>
        <div class="drawer-content">
            <div class="drawer-header">
                <h2 data-i18n="review.detailTitle">审核详情</h2>
                <button class="btn btn-ghost" type="button" data-drawer-close data-i18n="common.close">关闭</button>
            </div>
            <div class="drawer-body" data-drawer-body></div>
            <div class="drawer-footer" data-drawer-footer hidden>
                <div class="rule-hint">
                    <span class="hint-icon">💡</span>
                    <span data-i18n="review.ruleHint">审核理由将通知内容提交者，请客观公正地审核</span>
                </div>
                <div class="form-group">
                    <label class="form-label" data-i18n="review.reasonLabel">审核理由（10-200字）</label>
                    <textarea class="form-control" data-review-reason rows="3" placeholder="请输入审核理由" data-i18n-placeholder="review.reasonPlaceholder"></textarea>
                </div>
                <div class="action-row">
                    <button class="btn btn-primary" type="button" data-confirm-approve data-i18n="review.confirmApprove">确认通过</button>
                    <button class="btn btn-danger" type="button" data-confirm-reject data-i18n="review.confirmReject">确认驳回</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal" id="level-info-modal" hidden>
        <div class="modal-backdrop" data-modal-close></div>
        <div class="modal-content">
            <div class="modal-header">
                <h2>审核权限说明</h2>
                <button class="btn btn-ghost" type="button" data-modal-close>×</button>
            </div>
            <div class="modal-body">
                <table class="info-table">
                    <thead>
                        <tr>
                            <th>您的等级</th>
                            <th>可审核内容范围</th>
                            <th>可审核申诉范围</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="level-tag">LV3</span></td>
                            <td>聊天消息（LV1-LV2发布的内容）</td>
                            <td>LV1-LV2 的申诉</td>
                        </tr>
                        <tr>
                            <td><span class="level-tag">LV4</span></td>
                            <td>聊天消息、帖子（LV1-LV3发布的内容）</td>
                            <td>LV1-LV3 的申诉</td>
                        </tr>
                        <tr>
                            <td><span class="level-tag">LV5</span></td>
                            <td>所有内容（LV1-LV4），但不可自审</td>
                            <td>LV1-LV4 的申诉</td>
                        </tr>
                        <tr>
                            <td><span class="level-tag">LV5.5</span></td>
                            <td>所有内容，可临时锁定/禁言</td>
                            <td>LV1-LV5 的申诉</td>
                        </tr>
                        <tr>
                            <td><span class="level-tag">LV6</span></td>
                            <td>全部内容，拥有最高权限</td>
                            <td>所有申诉</td>
                        </tr>
                    </tbody>
                </table>
                <div class="info-note">
                    <p><strong>注意：</strong></p>
                    <ul>
                        <li>LV5 不可审核自己发布的内容</li>
                        <li>LV5.5 可临时锁定内容和临时禁言用户（1小时-3天）</li>
                        <li>LV6 可永久删除内容、修改用户等级、解禁IP</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <style>
