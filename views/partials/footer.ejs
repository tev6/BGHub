    </main>
    <footer class="site-footer">
        <div class="footer-shell">
            <div>
                <p class="footer-title" data-i18n="footer.title">BG Hub</p>
                <p class="footer-copy" data-i18n="footer.description">面向贝赛思学生的考试、作业、资源与互助一体化学习社区。</p>
            </div>
            <div class="footer-meta">
                <div class="view-count-box">
                    <span class="view-count-label" data-i18n="footer.viewCountLabel">本网站已被游览</span>
                    <span class="view-count-number" id="site-view-count">-</span>
                    <span class="view-count-label" data-i18n="footer.viewCountSuffix">次</span>
                </div>
                <span>&copy; <%= new Date().getFullYear() %> BG Hub</span>
                <span>Node.js + Express + SQLite</span>
            </div>
        </div>
    </footer>
    <script>
    (function() {
      fetch('/api/stats/record-view', { method: 'POST', credentials: 'include' })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var el = document.getElementById('site-view-count');
          if (el && data.viewCount !== undefined) {
            el.textContent = data.viewCount;
          }
        })
        .catch(function() {
          var el = document.getElementById('site-view-count');
          if (el) el.textContent = '0';
        });
    })();
    </script>
    <script src="/js/app.js"></script>
</body>
</html>
