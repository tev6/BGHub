<%- include('partials/header') %>
    <section class="page-title">
        <span class="eyebrow">CJ Board</span>
        <h1><%= (locale === 'en' && detail.board.name_en) ? detail.board.name_en : detail.board.name %> CJ</h1>
        <p><%= detail.board.description %></p>
    </section>

    <section class="cj-date-selector card">
        <div class="date-nav-row">
            <button type="button" id="cj-prev-btn" class="btn btn-ghost date-nav-btn" data-date="<%= dateNavData.prevDate %>">
                <span>‹</span>
            </button>
            <span class="date-nav-current" id="cj-date-display">
                <%= dateNavData.display %>
            </span>
            <button type="button" id="cj-next-btn" class="btn btn-ghost date-nav-btn <%= dateNavData.isFuture ? 'disabled' : '' %>" data-date="<%= dateNavData.nextDate %>" <%= dateNavData.isFuture ? 'aria-disabled="true"' : ''%>>
                <span>›</span>
            </button>
            <% if (user && user.role_level >= 1) { %>
                <button type="button" id="cj-edit-btn" class="btn btn-ghost" style="margin-left: auto;">✏️ 编辑</button>
            <% } %>
        </div>
    </section>

    <section class="cj-content">
        <div class="content-stack">
            <% ['IC', 'HW', 'A'].forEach(sectionKey => { %>
                <article class="card section-card" data-section="<%= sectionKey %>">
                    <div class="panel-head">
                        <div>
                            <span class="eyebrow" data-i18n="board.<%= sectionKey.toLowerCase() %>"><%= locale === 'en' ? sectionTitlesEn[sectionKey] : sectionTitles[sectionKey] %></span>
                            <h2><%= detail.sections[sectionKey] ? ((locale === 'en' && detail.sections[sectionKey].title_en) ? detail.sections[sectionKey].title_en : detail.sections[sectionKey].title) : (locale === 'en' ? sectionTitlesEn[sectionKey] : sectionTitles[sectionKey]) %></h2>
                        </div>
                        <% if (detail.sections[sectionKey] && detail.sections[sectionKey].updated_at) { %>
                            <span class="helper-text" data-i18n="board.lastUpdated"><%= locale === 'en' ? 'Updated at' : '更新于' %></span> <%= formatDate(detail.sections[sectionKey].updated_at, true) %>
                        <% } %>
                    </div>
                    <div class="section-markdown">
                        <%- renderMarkdown(detail.sections[sectionKey] ? detail.sections[sectionKey].content : '') || '<p class="empty-state" data-i18n="board.notFilled">' + (locale === 'en' ? 'Not yet filled' : '暂未填写') + '</p>' %>
                    </div>
                </article>
            <% }) %>
        </div>
    </section>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const initialDate = '<%= dateNavData.isToday && !dateStr ? "" : (dateStr || new Date().toISOString().split("T")[0]) %>';
        const todayStr = new Date().toISOString().split('T')[0];
        const currentDate = initialDate || todayStr;

        CJDateNav.init('<%= detail.board.slug %>', currentDate, '<%= locale %>');

        const editBtn = document.getElementById('cj-edit-btn');
        if (editBtn) {
            editBtn.addEventListener('click', function() {
                const dateToEdit = CJDateNav.getCurrentDate();
                window.location.href = '/cj/edit?subject=<%= detail.board.slug %>&date=' + dateToEdit;
            });
        }
    });
    </script>
    <script src="/js/board-date-nav.js"></script>
<%- include('partials/footer') %>